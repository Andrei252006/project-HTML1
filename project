<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SportsTournament Management System</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Inter,Segoe UI,Arial}
body{background:#f5f7fb;color:#1a2b4a}
.layout{display:flex;min-height:100vh}
.sidebar{width:250px;background:#0a2342;color:#fff;padding:20px 12px}
.brand{display:flex;gap:10px;margin-bottom:25px}.brand small{display:block;color:#8da0b8;font-size:11px}
.nav-btn{width:100%;text-align:left;padding:11px 12px;border:none;background:transparent;color:#a9bbd1;border-radius:8px;cursor:pointer;margin-bottom:6px}
.nav-btn.active{background:#0d6efd;color:#fff}
.content{flex:1;padding:30px;overflow:auto}
.page{display:none}.page.show{display:block}
h1{font-size:26px;margin-bottom:4px}
.muted{color:#8a9bb0;font-size:14px;margin-bottom:12px}
.card{background:#fff;border-radius:12px;padding:18px;box-shadow:0 2px 10px rgba(0,0,0,.05);margin-top:15px}
.banner{background:#0a2342;color:#fff;border-radius:12px;padding:18px;display:flex;gap:15px;align-items:center;margin:15px 0}
.ball{width:54px;height:54px;background:#ff8c00;border-radius:50%;display:grid;place-items:center;font-size:28px}
.stats4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.stat{background:#fff;padding:15px;border-radius:12px;position:relative}
.stat span{color:#8a9bb0;font-size:12px}.stat h2{font-size:26px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.table-wrap{overflow:auto}.search{width:100%;padding:10px;background:#ece4e9;border:none;border-radius:8px;margin:12px 0}
table{width:100%;border-collapse:collapse}th{background:#eef4ff;color:#5a6b8a;font-size:12px;padding:10px;text-align:left}td{padding:10px;border-top:1px solid #f0f0f0;font-size:14px}
.btn-blue{background:#0d6efd;color:#fff;border:none;padding:9px 18px;border-radius:8px;cursor:pointer}
.btn-light{background:#dbe7ff;color:#5a6b8a;border:none;padding:9px 18px;border-radius:8px;cursor:pointer}
.page-top{display:flex;justify-content:space-between;align-items:center}
.option-group{display:flex;gap:12px;margin:10px 0 20px}
.opt{border:2px solid #e5e7eb;padding:12px 20px;border-radius:10px;cursor:pointer;background:#f9fafb;text-align:center;min-width:120px}
.opt.active{border-color:#0d6efd;background:#eef4ff}
input,select{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;margin:6px 0 12px}
.form-actions{display:flex;justify-content:space-between;margin-top:15px}
.bracket-wrap{display:flex;gap:30px;overflow:auto;margin-top:15px}
.b-round{display:flex;flex-direction:column;gap:20px}
.match{border:1px solid #e5e7eb;border-radius:6px;padding:6px 10px;min-width:130px;background:#fff}
.pill-blue{background:#0d6efd;color:#fff;padding:4px 12px;border-radius:20px;font-size:12px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;place-items:center;z-index:99}
.modal.open{display:grid}
.modal-card{background:#fff;width:380px;border-radius:12px;padding:20px}
.modal-head{display:flex;justify-content:space-between;margin-bottom:15px}
.status{padding:2px 8px;border-radius:10px;font-size:11px}.completed{background:#dcfce7;color:#166534}.upcoming{background:#e0f2fe;color:#0c4a6e}
</style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="brand"><span>🏆</span><div><b>SportsTournament</b><small>Management System</small></div></div>
    <nav>
      <button class="nav-btn active" data-target="dashboard">⌂ Dashboard</button>
      <button class="nav-btn" data-target="new-tournament">⊕ New Tournament</button>
      <button class="nav-btn" data-target="teams">👥 Teams</button>
      <button class="nav-btn" data-target="players">👤 Players</button>
      <button class="nav-btn" data-target="games">📋 Games</button>
      <button class="nav-btn" data-target="standings">📊 Standings</button>
      <button class="nav-btn" data-target="bracket">🗓 Schedule / Bracket</button>
    </nav>
  </aside>
  <main class="content">
    <section id="dashboard" class="page show"><h1>Dashboard</h1><div class="banner"><div class="ball">🏀</div><div><h3 id="tourTitle">Basketball Tournament</h3><p>Single Elimination</p></div></div><div class="stats4"><div class="stat"><span>Total Teams</span><h2 id="s-teams">0</h2></div><div class="stat"><span>Total Players</span><h2 id="s-players">0</h2></div><div class="stat"><span>Total Games</span><h2 id="s-games">0</h2></div><div class="stat"><span>Completed</span><h2 id="s-done">0</h2></div></div><div class="two-col"><div class="card"><b>Recent Games</b><div id="recent-games"></div></div><div class="card"><b>Standings</b><div id="recent-standings"></div></div></div></section>
    <section id="new-tournament" class="page"><h1>New Tournament</h1><div class="card"><input id="tour-name" placeholder="Tournament Name"><h4>Select Sport</h4><div class="option-group" id="sport-opt"><div class="opt active" data-v="Basketball">🏀<br>Basketball</div><div class="opt" data-v="Volleyball">🏐<br>Volleyball</div></div><h4>Format</h4><div class="option-group" id="format-opt"><div class="opt active" data-v="Single Elimination">Single Elimination</div><div class="opt" data-v="Double Elimination">Double Elimination</div></div><button class="btn-blue" onclick="createTournament()">Create Tournament</button></div></section>
    <section id="teams" class="page"><div class="page-top"><div><h1>Teams</h1><p class="muted">Manage and organize the tournament.</p></div><button class="btn-blue" onclick="openModal('teamModal')">+ ADD TEAM</button></div><input class="search" id="teamSearch" placeholder="🔍 Search teams.." oninput="renderTeams()"><div class="card table-wrap"><table><thead><tr><th>#</th><th>Team Name</th><th>Sport</th><th>Actions</th></tr></thead><tbody id="teamsBody"></tbody></table></div></section>
    <section id="players" class="page"><h1>Add Player</h1><div class="card"><label>Player Name</label><input id="pl-name" placeholder="Player name"><div class="two-col"><div><label>Team</label><select id="pl-team"></select></div><div><label>Jersey Number</label><input id="pl-jersey" type="number" placeholder="Enter jersey number"></div></div><label>Position</label><select id="pl-pos"><option>Select position</option><option>Guard</option><option>Forward</option><option>Center</option></select><div class="form-actions"><button class="btn-light" onclick="clearPlayer()">Cancel</button><button class="btn-blue" onclick="addPlayer()">Save</button></div></div><div class="card table-wrap"><table><thead><tr><th>#</th><th>Player</th><th>Team</th><th>Jersey</th><th>Position</th></tr></thead><tbody id="playersBody"></tbody></table></div></section>
    <section id="games" class="page"><div class="page-top"><h1>Game Scores</h1><button class="btn-blue" onclick="saveAllScores()">Save Scores</button></div><div class="card table-wrap"><table><thead><tr><th>#</th><th>Match</th><th>Score A</th><th>Score B</th><th>Status</th></tr></thead><tbody id="gamesBody"></tbody></table></div></section>
    <section id="standings" class="page"><h1>Standings</h1><div class="card table-wrap"><table><thead><tr><th>Rank</th><th>Team</th><th>P</th><th>W</th><th>L</th><th>PF</th><th>PA</th><th>Diff</th></tr></thead><tbody id="standingsBody"></tbody></table></div></section>
    <section id="bracket" class="page"><div class="page-top"><h1>Tournament Bracket</h1><button class="btn-blue" onclick="generateBracket()">Generate Bracket</button></div><div class="card"><div class="bracket-wrap" id="bracketView"></div><h4 style="margin-top:20px">Schedule</h4><div class="table-wrap"><table><thead><tr><th>Match</th><th>Date</th><th>Time</th><th>Venue</th></tr></thead><tbody id="scheduleBody"></tbody></table></div></div></section>
  </main>
</div>
<div class="modal" id="teamModal"><div class="modal-card"><div class="modal-head"><h3>👥 Add Team</h3><button onclick="closeModal('teamModal')">X</button></div><label>Team Name</label><input id="teamNameInput" placeholder="Enter team name"><label>Sport</label><select id="teamSportInput"><option>Basketball</option><option>Volleyball</option></select><div class="form-actions"><button class="btn-light" onclick="closeModal('teamModal')">Cancel</button><button class="btn-blue" onclick="saveTeam()">Save</button></div></div></div>

<script>
let db = JSON.parse(localStorage.getItem('stms')) || { sport:'Basketball', format:'Single Elimination', teams:[], players:[], games:[] };
const save = () => { localStorage.setItem('stms', JSON.stringify(db)); render(); };
document.querySelectorAll('.nav-btn').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.nav-btn').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('show'));
    b.classList.add('active');
    document.getElementById(b.dataset.target).classList.add('show');
  }
});
document.querySelectorAll('#sport-opt.opt').forEach(o=>{
  o.onclick=()=>{ document.querySelectorAll('#sport-opt.opt').forEach(x=>x.classList.remove('active')); o.classList.add('active'); db.sport=o.dataset.v; save(); }
});
document.querySelectorAll('#format-opt.opt').forEach(o=>{
  o.onclick=()=>{ document.querySelectorAll('#format-opt.opt').forEach(x=>x.classList.remove('active')); o.classList.add('active'); db.format=o.dataset.v; save(); }
});
function createTournament(){ db.tourName=document.getElementById('tour-name').value||'Basketball Tournament'; document.getElementById('tourTitle').innerText=db.tourName; generateGames(); save(); alert('Tournament Created!'); }
function openModal(id){document.getElementById(id).classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}
function saveTeam(){
  const name=document.getElementById('teamNameInput').value; if(!name) return alert('Enter team name');
  const sport=document.getElementById('teamSportInput').value;
  db.teams.push({id:Date.now(), name, sport, P:0,W:0,L:0,PF:0,PA:0,Diff:0});
  closeModal('teamModal'); document.getElementById('teamNameInput').value=''; generateGames(); save();
}
function generateGames(){
  db.games=[]; for(let i=0;i<db.teams.length;i++) for(let j=i+1;j<db.teams.length;j++){
    db.games.push({id:`${i}-${j}`, a:db.teams[i].name, b:db.teams[j].name, sa:0, sb:0, done:false});
  }
}
function addPlayer(){
  const p={name:document.getElementById('pl-name').value, team:document.getElementById('pl-team').value, jersey:document.getElementById('pl-jersey').value, pos:document.getElementById('pl-pos').value};
  if(!p.name) return; db.players.push(p); save(); clearPlayer();
}
function clearPlayer(){ document.getElementById('pl-name').value=''; document.getElementById('pl-jersey').value=''; }
function saveAllScores(){
  document.querySelectorAll('.sA').forEach(inp=>{ let g=db.games.find(x=>x.id==inp.dataset.id); g.sa=+inp.value; });
  document.querySelectorAll('.sB').forEach(inp=>{ let g=db.games.find(x=>x.id==inp.dataset.id); g.sb=+inp.value; g.done=(g.sa>0||g.sb>0); });
  calcStandings(); save(); alert('Scores Saved!');
}
function calcStandings(){
  db.teams.forEach(t=>{t.P=0;t.W=0;t.L=0;t.PF=0;t.PA=0;t.Diff=0});
  db.games.forEach(g=>{ if(!g.done) return; let ta=db.teams.find(t=>t.name==g.a), tb=db.teams.find(t=>t.name==g.b); if(!ta||!tb) return; ta.P++; tb.P++; ta.PF+=g.sa; ta.PA+=g.sb; tb.PF+=g.sb; tb.PA+=g.sa; if(g.sa>g.sb){ta.W++; tb.L++;} else if(g.sb>g.sa){tb.W++; ta.L++;} });
  db.teams.forEach(t=>t.Diff=t.PF-t.PA); db.teams.sort((x,y)=>y.W-x.W || y.Diff-x.Diff);
}
function generateBracket(){
  const wrap=document.getElementById('bracketView'); wrap.innerHTML='';
  if(db.teams.length<2){wrap.innerHTML='Add at least 2 teams'; return;}
  const q=document.createElement('div'); q.className='b-round'; q.innerHTML='<small>Quarterfinals</small>';
  const s=document.createElement('div'); s.className='b-round'; s.innerHTML='<small>Semifinals</small>';
  const f=document.createElement('div'); f.className='b-round'; f.innerHTML='<small>Final</small>';
  db.teams.slice(0,8).forEach(t=>{ q.innerHTML+=`<div class="match">${t.name} <span style="float:right">0</span></div>`; });
  for(let i=0;i<2;i++) s.innerHTML+=`<div class="match">Team<br>Team</div>`;
  f.innerHTML+=`<div class="match">Team<br>Team</div>`;
  wrap.append(q,s,f);
  document.getElementById('scheduleBody').innerHTML=db.games.slice(0,3).map(g=>`<tr><td>${g.a} vs ${g.b}</td><td>Feb 5, 2027</td><td>10:00 AM</td><td>Court 1</td></tr>`).join('');
}
function render(){
  document.getElementById('s-teams').textContent=db.teams.length;
  document.getElementById('s-players').textContent=db.players.length;
  document.getElementById('s-games').textContent=db.games.length;
  document.getElementById('s-done').textContent=db.games.filter(g=>g.done).length;
  const q=(document.getElementById('teamSearch')?.value||'').toLowerCase();
  document.getElementById('teamsBody').innerHTML=db.teams.filter(t=>t.name.toLowerCase().includes(q)).map((t,i)=>`<tr><td>${i+1}</td><td>${t.name}</td><td>${t.sport}</td><td>✏️ 🗑️</td></tr>`).join('');
  document.getElementById('pl-team').innerHTML=db.teams.map(t=>`<option>${t.name}</option>`).join('') || '<option>No teams</option>';
  document.getElementById('playersBody').innerHTML=db.players.map((p,i)=>`<tr><td>${i+1}</td><td>${p.name}</td><td>${p.team}</td><td>${p.jersey}</td><td>${p.pos}</td></tr>`).join('');
  document.getElementById('gamesBody').innerHTML=db.games.map((g,i)=>`<tr><td>${i+1}</td><td>${g.a} vs ${g.b}</td><td><input class="sA" data-id="${g.id}" type="number" value="${g.sa}" style="width:60px"></td><td><input class="sB" data-id="${g.id}" type="number" value="${g.sb}" style="width:60px"></td><td><span class="status ${g.done?'completed':'upcoming'}">${g.done?'Completed':'Upcoming'}</span></td></tr>`).join('');
  document.getElementById('standingsBody').innerHTML=db.teams.map((t,i)=>`<tr><td>${i+1}</td><td>${t.name}</td><td>${t.P}</td><td>${t.W}</td><td>${t.L}</td><td>${t.PF}</td><td>${t.PA}</td><td>${t.Diff}</td></tr>`).join('');
  document.getElementById('recent-games').innerHTML=db.games.slice(0,3).map(g=>`<div style="padding:6px 0;border-bottom:1px solid #eee;display:flex;justify-content:space-between"><span>${g.a} vs ${g.b}</span><span>${g.sa} - ${g.sb}</span></div>`).join('')||'No games yet';
  document.getElementById('recent-standings').innerHTML=db.teams.slice(0,3).map((t,i)=>`<div style="padding:6px 0;border-bottom:1px solid #eee;display:flex;justify-content:space-between"><span>${i+1}. ${t.name}</span><span>${t.W}-${t.L}</span></div>`).join('')||'No teams yet';
}
function renderTeams(){ render(); }
render();
</script>
</body>
</html>
